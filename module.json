{
  "id": "gatos-scene-ai",
  "title": "Gato's Scene AI",
  "description": "개인 AI API 키나 로컬 LLM을 연결해 장면 배경 지도에 격자를 자동으로 맞추고, 지도를 읽어 벽·문·광원을 자동으로 배치합니다. Anthropic, OpenAI, Gemini, OpenRouter와 Ollama·LM Studio·llama.cpp 같은 OpenAI 호환 로컬 서버를 지원합니다. 시스템 무관.",
  "version": "0.2.0",
  "authors": [
    {
      "name": "jesun"
    }
  ],
  "url": "https://github.com/snowcat0w0/gatos-scene-ai",
  "manifest": "https://raw.githubusercontent.com/snowcat0w0/gatos-scene-ai/master/module.json",
  "download": "https://github.com/snowcat0w0/gatos-scene-ai/releases/download/v0.2.0/gatos-scene-ai.zip",
  "compatibility": {
    "minimum": "13",
    "verified": "13"
  },
  "relationships": {
    "requires": [
      {
        "id": "gatos-lib",
        "type": "module",
        "compatibility": {
          "minimum": "1.0.0-alpha.1"
        },
        "manifest": "https://raw.githubusercontent.com/snowcat0w0/gatos-lib/master/module.json"
      }
    ]
  },
  "esmodules": [
    "scripts/module.js"
  ],
  "styles": [
    "styles/scene-ai.css"
  ],
  "languages": [
    {
      "lang": "en",
      "name": "English",
      "path": "lang/en.json"
    },
    {
      "lang": "ko",
      "name": "한국어",
      "path": "lang/ko.json"
    }
  ]
}
